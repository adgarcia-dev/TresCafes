---
import { Font } from 'astro:assets';
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Tres Cafés' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <Font cssVariable="--font-gloock" preload />
    <Font cssVariable="--font-hanken" preload />
  </head>
  <body class="bg-paper text-ink font-sans text-body antialiased">
    <slot />
  </body>
</html>
